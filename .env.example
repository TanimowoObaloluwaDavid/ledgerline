# Where the CLI keeps its SQLite ledger (`:memory:` for a throwaway book).
LEDGERLINE_DB=./data/ledger.db

# HTTP server.
LEDGERLINE_HOST=127.0.0.1
LEDGERLINE_PORT=3000
LEDGERLINE_LOG=true

# Reporting defaults. The functional currency is what every report is
# presented in; the retained-earnings and FX-clearing accounts must exist in the
# chart of accounts.
LEDGERLINE_CURRENCY=USD
LEDGERLINE_RETAINED_EARNINGS=3200
LEDGERLINE_FX_CLEARING=3210
